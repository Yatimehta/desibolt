# ============================================================
# DESI BOLT — Backend Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env to version control.
# ============================================================

# --- SERVER ---
NODE_ENV=development
PORT=5001

# --- DATABASE (PostgreSQL) ---
# Local:   postgresql://postgres:yourpassword@localhost:5432/desibolt
# Railway: auto-injected as DATABASE_URL when you add a PostgreSQL plugin
# Leave blank to use the in-memory fallback (dev/test only)
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/desibolt

# --- JWT AUTHENTICATION ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING

# --- STRIPE (EUR / Malta) ---
# Test keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_TEST_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SIGNING_SECRET
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_TEST_PUBLISHABLE_KEY

# --- CORS ---
# Your frontend dev URL (Vite default)
CORS_ORIGIN=http://localhost:5173

# --- RATE LIMITING ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# --- SMTP (Order confirmation emails — optional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=orders@desibolt.com
SMTP_PASS=REPLACE_WITH_APP_PASSWORD
EMAIL_FROM="DESI BOLT Orders <orders@desibolt.com>"
